# Copia este fichero a backend/.env y rellena lo que vayas a usar.
#
# Ninguna clave es obligatoria para arrancar ni para correr los tests: los secretos
# nacen vacíos y quien los exige es el módulo que va a usarlos, en el momento de
# usarlos. Sin Telegram los gates no notifican; sin Langfuse no se emiten trazas.
#
# Ningún secreto se commitea: gitleaks lo comprueba en G0 (pre-commit) y en G1 (CI).

# --- Rutas -------------------------------------------------------------------
# El directorio es el registro de novelas: una novela es un fichero (arq. §16.4).
STORYMAKER_DIRECTORIO_PROYECTOS=proyectos

# --- Modelo ------------------------------------------------------------------
# Aquí no hay ninguna credencial, y es deliberado. La única puerta al modelo es el
# Claude Agent SDK, que lanza Claude Code como subproceso y hereda la sesión ya
# iniciada del Autor: el arnés fija por invocación el modelo, las herramientas, los
# turnos y los techos, pero no autentica. Todos los roles corren en Haiku 4.5, y qué
# modelo usó cada uno se declara en Settings.modelo_por_rol y viaja al manifiesto.

# --- Gates -------------------------------------------------------------------
# En batch los cinco gates quedan desactivados, que es como corren los briefs de eval.
STORYMAKER_GATES_ENABLED=true
STORYMAKER_TIMEOUT_GATE_HORAS=24

# --- Telegram ----------------------------------------------------------------
# Solo avisa: los gates se deciden en el PC con `storymaker decidir`. Crea el bot
# con @BotFather, escribele y saca el chat_id de getUpdates.
STORYMAKER_TELEGRAM_BOT_TOKEN=
STORYMAKER_TELEGRAM_CHAT_ID=

# --- Langfuse ----------------------------------------------------------------
STORYMAKER_LANGFUSE_PUBLIC_KEY=
STORYMAKER_LANGFUSE_SECRET_KEY=
STORYMAKER_LANGFUSE_HOST=https://cloud.langfuse.com
STORYMAKER_OTLP_ENABLED=false
