{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storymaker/contexto-historico@1",
  "title": "CTR-004 - Contexto Historico sellado (Etapa 1 -> Etapa 2)",
  "description": "Artefacto SELLADO. Una vez sellado no admite escritura de ninguna clase: un intento es ERR-501, error de sistema, no operacion denegada. La unica via de cambio es repetir la etapa (RF-066).",
  "type": "object",
  "required": [
    "esquema",
    "proyecto",
    "estado",
    "sellado_en",
    "dimensiones",
    "afirmaciones",
    "inventario_prohibidos",
    "cobertura"
  ],
  "properties": {
    "esquema": {
      "const": "contexto-historico@1"
    },
    "proyecto": {
      "type": "string"
    },
    "estado": {
      "const": "Cerrado"
    },
    "sellado_en": {
      "type": "string",
      "format": "date-time"
    },
    "dimensiones": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "afirmaciones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "enunciado",
          "dimension",
          "estado",
          "fuente",
          "fragmento",
          "veredicto_ref"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AF-[0-9]{4}$"
          },
          "enunciado": {
            "type": "string",
            "minLength": 1
          },
          "dimension": {
            "type": "string"
          },
          "estado": {
            "const": "Verificada"
          },
          "fuente": {
            "type": "object",
            "required": [
              "url",
              "titulo",
              "dominio",
              "consultada_en"
            ],
            "properties": {
              "url": {
                "type": "string"
              },
              "titulo": {
                "type": "string"
              },
              "dominio": {
                "type": "string",
                "description": "Se registra para el informe (R-02, R-09). NO se usa para filtrar: filtrar exigiria un criterio que el funcional no da y contradiria RES-5."
              },
              "consultada_en": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "fragmento": {
            "type": "string",
            "minLength": 1,
            "description": "Copiado literalmente de la fuente y acotado a lo pertinente (RF-007)."
          },
          "veredicto_ref": {
            "type": "string"
          },
          "intento": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          }
        }
      }
    },
    "inventario_prohibidos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "elemento",
          "categoria",
          "afirmacion_ref"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "elemento": {
            "type": "string"
          },
          "categoria": {
            "enum": [
              "lexico",
              "material",
              "tecnologico",
              "institucional",
              "mentalidad"
            ]
          },
          "afirmacion_ref": {
            "type": "string",
            "pattern": "^AF-[0-9]{4}$"
          },
          "disputado": {
            "type": "boolean"
          },
          "precision_geografica": {
            "type": "string"
          }
        }
      }
    },
    "contradicciones_arbitradas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "par",
          "decision_autor",
          "motivo",
          "decidido_en"
        ]
      }
    },
    "cobertura": {
      "type": "object",
      "required": [
        "estado",
        "por_dimension",
        "rondas_consumidas"
      ],
      "properties": {
        "estado": {
          "enum": [
            "Completa",
            "Incompleta"
          ]
        },
        "por_dimension": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "dimensiones_deficitarias": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rondas_consumidas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "advertencia": {
          "type": "string",
          "description": "OBLIGATORIA si estado = Incompleta. Es el asterisco con el que el Contexto se acepta: dice cuantas afirmaciones se lograron de las cinco y que la ejecucion continuo sin escalar (E82)."
        },
        "dimensiones_cubiertas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "invariantes_al_sellar": {
    "_comprueba": "CMP-009",
    "lista": [
      "Ninguna afirmacion en estado distinto de Verificada.",
      "Toda entrada del inventario remite a una afirmacion presente en el artefacto.",
      "COMO MAXIMO una afirmacion por dimension (E82).",
      "COMO MAXIMO el total declarado en configuracion.json (E82: cinco).",
      "No hay minimo por dimension: ninguna dimension es obligatoria desde E82.",
      "Ninguna contradiccion detectada sin arbitrar (RF-015, PCH-2).",
      "Si no se alcanzo el total, estado = Incompleta y advertencia no vacia. NO hace falta confirmacion del autor: la ejecucion continua (E82).",
      "Cero afirmaciones verificadas impide sellar: la etapa termina en fallo explicito (ERR-903)."
    ]
  }
}