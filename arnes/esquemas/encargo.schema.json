{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storymaker/encargo@1",
  "title": "CTR-001 - Encargo (Etapa 0 -> Etapa 1)",
  "description": "Contrato de entrada al arnes. Es tambien el formato del fichero de Encargo de RF-063. additionalProperties es false por ser entrada al arnes: lo desconocido se ignora y se enumera como ERR-104 / campo_ignorado.",
  "type": "object",
  "additionalProperties": false,
  "required": ["esquema", "epoca", "tema", "personajes_partida", "inspiracion", "parametros"],
  "properties": {
    "esquema": { "const": "encargo@1" },
    "epoca": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intervalo_temporal", "ambito_geografico"],
      "properties": {
        "intervalo_temporal": { "type": "string", "minLength": 1, "description": "Acotado. 'la antiguedad' no es un intervalo: ERR-102." },
        "ambito_geografico": { "type": "string", "minLength": 1 }
      }
    },
    "tema": { "type": "string", "minLength": 1 },
    "personajes_partida": {
      "type": "array",
      "description": "La lista vacia equivale a 'ninguno' y es valida.",
      "items": {
        "type": "object",
        "required": ["nombre_o_descripcion"],
        "properties": {
          "nombre_o_descripcion": { "type": "string", "minLength": 1 },
          "naturaleza": { "enum": ["Ficticio", "Real", "Sin_declarar"] }
        }
      }
    },
    "inspiracion": { "type": "string", "description": "'ninguna' es un valor valido." },
    "parametros": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capitulos", "parrafos_por_capitulo", "lineas_por_capitulo", "palabras_por_linea"],
      "properties": {
        "capitulos": { "type": "integer", "minimum": 1 },
        "parrafos_por_capitulo": { "type": "integer", "minimum": 1 },
        "lineas_por_capitulo": { "type": "integer", "minimum": 1 },
        "palabras_por_linea": { "type": "integer", "minimum": 1 }
      }
    },
    "estado": { "enum": ["Incompleto", "Completo", "Congelado"] },
    "canal": { "enum": ["dialogo", "fichero"], "description": "Origen del Encargo, para RNF-030." },
    "congelado_en": { "type": "string", "format": "date-time" }
  },
  "restricciones_cruzadas_no_expresables": [
    {
      "regla": "lineas_por_capitulo >= parrafos_por_capitulo",
      "origen": "RF-002",
      "incumplimiento": "ERR-101",
      "comprueba": "CMP-011 (dialogo) o CMP-012 (fichero)"
    }
  ],
  "campos_ignorados": {
    "regla": "Cualquier campo fuera de los declarados se ignora, se enumera y se registra en bitacora como 'campo_ignorado' (ERR-104, RF-063 escenarios 3 y 4). En particular limites de iteracion, topes, tolerancias y severidades: esos viven SOLO en arnes/configuracion.json (E70).",
    "no_detiene_la_ejecucion": true
  }
}
