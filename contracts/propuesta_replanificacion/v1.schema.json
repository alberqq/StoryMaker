{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storymaker/contracts/propuesta_replanificacion/v1",
  "title": "propuesta_replanificacion",
  "description": "Contrato CT-9 de la Especificacion Tecnica 2.0, seccion 6.2.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "emisor": {
      "type": "string",
      "minLength": 1
    },
    "motivo": {
      "type": "string",
      "minLength": 1
    },
    "elementos_afectados": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "impacto_estimado": {
      "type": "string",
      "minLength": 1
    },
    "alternativa_sugerida": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "emisor",
    "motivo",
    "elementos_afectados",
    "impacto_estimado"
  ],
  "additionalProperties": false
}
