{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storymaker/contracts/escena_piloto/v1",
  "title": "escena_piloto",
  "description": "Contrato CT-19 de la Especificacion Tecnica 2.0, seccion 6.2.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "version_escena": {
      "type": "string",
      "pattern": "^[a-z]{3}_[a-z0-9][A-Za-z0-9_.-]*$"
    },
    "texto": {
      "type": "string",
      "minLength": 1
    },
    "ficha_escena": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]{3}_[a-z0-9][A-Za-z0-9_.-]*$"
        },
        "orden": {
          "type": "integer",
          "minimum": 1
        },
        "funcion_narrativa": {
          "type": "string",
          "minLength": 1
        },
        "personajes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]{3}_[a-z0-9][A-Za-z0-9_.-]*$"
          }
        },
        "lugar": {
          "type": [
            "string",
            "null"
          ]
        },
        "momento": {
          "type": [
            "string",
            "null"
          ]
        },
        "hilos": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]{3}_[a-z0-9][A-Za-z0-9_.-]*$"
          }
        },
        "revelaciones": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]{3}_[a-z0-9][A-Za-z0-9_.-]*$"
          }
        },
        "presupuesto_palabras": {
          "type": "integer",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "id",
        "orden",
        "funcion_narrativa",
        "presupuesto_palabras"
      ],
      "additionalProperties": false
    },
    "parametros_estilo_aplicados": {
      "type": "object"
    },
    "procedencia_parametros": {
      "type": "object"
    },
    "alternativas_de_voz": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "schema_version",
    "version_escena",
    "texto",
    "ficha_escena",
    "parametros_estilo_aplicados",
    "procedencia_parametros"
  ],
  "additionalProperties": false
}
