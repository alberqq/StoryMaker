{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storymaker/contracts/decision_piloto/v1",
  "title": "decision_piloto",
  "description": "Contrato CT-20 de la Especificacion Tecnica 2.0, seccion 6.2.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "decision": {
      "enum": [
        "aceptar",
        "ajustar_estilo",
        "volver_al_canon"
      ]
    },
    "motivo": {
      "type": "string"
    },
    "elemento_afectado": {
      "type": [
        "string",
        "null"
      ]
    },
    "decidido_por": {
      "type": "string",
      "minLength": 1
    },
    "decidido_en": {
      "type": "string",
      "format": "fecha-hora"
    }
  },
  "required": [
    "schema_version",
    "decision",
    "decidido_por"
  ],
  "additionalProperties": false,
  "if": {
    "type": "object",
    "properties": {
      "decision": {
        "enum": [
          "ajustar_estilo",
          "volver_al_canon"
        ]
      }
    },
    "required": [
      "decision"
    ],
    "additionalProperties": true
  },
  "then": {
    "required": [
      "elemento_afectado"
    ]
  }
}
